---
import Header from './Header.astro';
import MapControls from './MapControls.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const strings = t(locale);
---

<div class="app">
  <Header locale={locale} currentPath={currentPath} surface="app" />

  <main class="app__main" id="map-root">
    <div
      id="map"
      class="app__map"
      role="application"
      aria-label={strings.tagline}
      data-occupancy={strings.occupancy}
      data-avg-occupancy={strings.avgOccupancy}
      data-rating-very-good={strings.ratingVeryGood}
      data-rating-good={strings.ratingGood}
      data-rating-fair={strings.ratingFair}
      data-rating-bad={strings.ratingBad}
      data-rating-very-bad={strings.ratingVeryBad}
      data-bikes={strings.bikes}
      data-docks={strings.docks}
      data-no-data={strings.noData}
      data-attribution={strings.attribution}
      data-locate-me={strings.locateMe}
      data-locate-denied={strings.locateDenied}
      data-locate-outside={strings.locateOutside}
      data-locate-insecure={strings.locateInsecure}
      data-locale={locale}
    ></div>

    <div class="app__panel">
      <MapControls locale={locale} />
    </div>
  </main>
</div>

<style>
  .app {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .app__main {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .app__map {
    position: absolute;
    inset: 0;
  }

  .app__panel {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    max-width: 28rem;
    pointer-events: none;
  }

  .app__panel > :global(*) {
    pointer-events: auto;
  }

  :global(.maplibregl-ctrl-top-right) {
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
  }

  :global(.busymad-popup .maplibregl-popup-content) {
    padding: 0.55rem 0.7rem;
    border-radius: 0.55rem;
    background: var(--paper-elevated);
    color: var(--ink);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  :global(.map-popup) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  :global(.map-popup strong) {
    font-size: 0.875rem;
    font-weight: 600;
  }

  :global(.map-popup em) {
    font-style: normal;
    font-weight: 700;
    color: var(--accent);
  }

  :global(.map-popup__rating) {
    display: inline-block;
    align-self: flex-start;
    margin: 0.1rem 0 0.05rem;
    padding: 0.1rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  :global(.map-popup__rating--veryGood) {
    color: #0f5132;
    background: rgba(42, 157, 143, 0.22);
  }

  :global(.map-popup__rating--good) {
    color: #1b5e3b;
    background: rgba(82, 183, 136, 0.22);
  }

  :global(.map-popup__rating--fair) {
    color: #7a5a12;
    background: rgba(233, 196, 106, 0.28);
  }

  :global(.map-popup__rating--bad) {
    color: #8a3b1a;
    background: rgba(244, 132, 95, 0.24);
  }

  :global(.map-popup__rating--veryBad) {
    color: #842029;
    background: rgba(230, 57, 70, 0.2);
  }

  :global(html[data-theme='dark'] .map-popup__rating--veryGood) {
    color: #2dd4a0;
    background: rgba(45, 212, 160, 0.18);
  }

  :global(html[data-theme='dark'] .map-popup__rating--good) {
    color: #52b788;
    background: rgba(82, 183, 136, 0.18);
  }

  :global(html[data-theme='dark'] .map-popup__rating--fair) {
    color: #e9c46a;
    background: rgba(233, 196, 106, 0.16);
  }

  :global(html[data-theme='dark'] .map-popup__rating--bad) {
    color: #f4a261;
    background: rgba(244, 162, 97, 0.16);
  }

  :global(html[data-theme='dark'] .map-popup__rating--veryBad) {
    color: #f07167;
    background: rgba(240, 113, 103, 0.18);
  }

  :global(.maplibregl-popup-tip) {
    display: none;
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-group) {
    background: rgba(28, 33, 30, 0.9);
    border: 1px solid rgba(230, 235, 228, 0.1);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-group button) {
    background: transparent;
    border-color: rgba(230, 235, 228, 0.1);
    color: var(--ink-muted);
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-group button + button) {
    border-top-color: rgba(230, 235, 228, 0.1);
  }

  /* MapLibre icons follow prefers-color-scheme, not data-theme — muted light glyphs (~ink-muted) */
  :global(html[data-theme='dark'] .maplibregl-ctrl-group button .maplibregl-ctrl-icon) {
    filter: brightness(0) invert(0.62);
    opacity: 0.92;
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-group button:hover) {
    background: rgba(230, 235, 228, 0.08);
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-group button:hover .maplibregl-ctrl-icon) {
    filter: brightness(0) invert(0.78);
    opacity: 1;
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-attrib) {
    background: rgba(15, 18, 16, 0.82);
    color: rgba(232, 236, 230, 0.65);
  }

  :global(html[data-theme='dark'] .maplibregl-ctrl-attrib a) {
    color: rgba(78, 207, 154, 0.85);
  }

  @media (min-width: 720px) {
    .app__panel {
      left: 1.25rem;
      bottom: 1.25rem;
      max-width: 24rem;
    }
  }

  @media (max-width: 520px) {
    .app__panel {
      left: 0.5rem;
      right: 0.5rem;
      bottom: max(0.5rem, env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  import { initMap, resizeMap, getStationCount } from '../lib/map';
  import { initControls } from '../lib/controls';

  const mapEl = document.getElementById('map');
  const countEl = document.querySelector('.header__count');

  initControls();

  if (mapEl) {
    const locale = mapEl.dataset.locale === 'en' ? 'en' : 'es';
    const localeStrings = {
      occupancy: mapEl.dataset.occupancy ?? 'Occupancy',
      avgOccupancy: mapEl.dataset.avgOccupancy ?? 'Avg occupancy',
      ratingVeryGood: mapEl.dataset.ratingVeryGood ?? 'Very good',
      ratingGood: mapEl.dataset.ratingGood ?? 'Good',
      ratingFair: mapEl.dataset.ratingFair ?? 'Fair',
      ratingBad: mapEl.dataset.ratingBad ?? 'Bad',
      ratingVeryBad: mapEl.dataset.ratingVeryBad ?? 'Very bad',
      bikes: mapEl.dataset.bikes ?? 'bikes',
      docks: mapEl.dataset.docks ?? 'docks',
      noData: mapEl.dataset.noData ?? mapEl.getAttribute('data-no-data') ?? 'No data',
      attribution:
        mapEl.dataset.attribution ??
        "© OpenStreetMap · Powered by <a href='https://www.emtmadrid.es' target='_blank' rel='noopener noreferrer'>EMT de Madrid</a>",
      locateMe: mapEl.dataset.locateMe ?? 'Go to my location',
      locateDenied: mapEl.dataset.locateDenied ?? 'Could not get your location. Check GPS permission.',
      locateOutside: mapEl.dataset.locateOutside ?? 'Your location is outside the Madrid map area.',
      locateInsecure:
        mapEl.dataset.locateInsecure ??
        'GPS only works over HTTPS (or localhost). Open the site via https://.',
    };

    initMap(mapEl, locale, localeStrings).then(() => {
      const n = getStationCount();
      if (countEl && n > 0) {
        countEl.textContent = countEl.textContent?.replace(/^\d+/, String(n)) ?? `${n}`;
      }
      resizeMap();
    });
  }

  window.addEventListener('resize', () => resizeMap());
</script>

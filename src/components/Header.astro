---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  locale: Locale;
  currentPath: string;
  stationCount?: number;
}

const { locale, currentPath, stationCount = 0 } = Astro.props;
const strings = t(locale);
---

<header class="header">
  <div class="header__brand">
    <a href={locale === 'en' ? '/en/' : '/'} class="header__logo">
      <span class="header__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="17" r="3.2"></circle>
          <circle cx="18" cy="17" r="3.2"></circle>
          <path d="M9 17h6M6 14l3-7h6l3 7"></path>
          <path d="M12 7V4"></path>
        </svg>
      </span>
      <span class="header__text">
        <strong>{strings.siteName}</strong>
        <span>{strings.tagline}</span>
      </span>
    </a>
    <span class="header__badge">{strings.dataBadge}</span>
  </div>

  <div class="header__meta">
    {stationCount > 0 && (
      <span class="header__count mono">{stationCount} {strings.stations}</span>
    )}
    <a
      class="header__license"
      href={locale === 'en' ? '/en/license/' : '/licencia/'}
      rel="license"
    >
      {strings.licenseNav}
    </a>
    <a
      class="header__icon header__icon--mail"
      href="mailto:daniruso@duck.com"
      aria-label={strings.emailLabel}
    >
      <svg class="mail" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect class="mail__body" x="3" y="7.5" width="18" height="12" rx="2"></rect>
        <path class="mail__lid" d="M3.2 8 L12 14.5 L20.8 8"></path>
      </svg>
    </a>
    <a
      class="header__icon"
      href="https://github.com/DaniWS/bussymad"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={strings.githubLabel}
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        ></path>
      </svg>
    </a>
    <LanguageSwitcher currentPath={currentPath} />
    <ThemeToggle locale={locale} />
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-h);
    padding: 0 1rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper-elevated);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: visible;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .header__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
  }

  .header__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .header__text strong {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .header__text span:last-child {
    font-size: 0.75rem;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__badge {
    display: none;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .header__license {
    padding: 0.4rem 0.55rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    white-space: nowrap;
  }

  .header__license:hover,
  .header__license:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .header__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    opacity: 0.72;
    overflow: visible;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .header__icon:hover,
  .header__icon:focus-visible {
    opacity: 1;
  }

  .header__icon svg {
    display: block;
    overflow: visible;
  }

  .header__icon--mail:hover,
  .header__icon--mail:focus-visible {
    transform: translateY(-0.28rem);
  }

  .mail__lid {
    transform-box: view-box;
    transform-origin: 12px 8px;
    transition: transform 0.38s var(--ease);
  }

  .header__icon--mail:hover .mail__lid,
  .header__icon--mail:focus-visible .mail__lid {
    transform: scaleY(-1);
  }

  .header__count {
    display: none;
    font-size: 0.6875rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .mono {
    font-family: var(--font-mono);
  }

  @media (min-width: 640px) {
    .header {
      padding: 0 1.25rem;
    }

    .header__badge {
      display: inline-flex;
    }

    .header__count {
      display: inline;
    }
  }

  @media (max-width: 420px) {
    .header__text span:last-child {
      display: none;
    }
  }
</style>

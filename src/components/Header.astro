---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Locale } from '../lib/i18n';
import { appPath, homePath, licensePath } from '../lib/i18n';
import { t, GITHUB_REPO_URL, LINKEDIN_URL, PERSONAL_SITE_URL } from '../lib/translations';

interface Props {
  locale: Locale;
  currentPath: string;
  stationCount?: number;
  surface?: 'site' | 'app' | 'doc';
}

const { locale, currentPath, stationCount = 0, surface = 'site' } = Astro.props;
const strings = t(locale);
const logoHref = homePath(locale);
---

<header class="header" data-header>
  <div class="header__inner">
    <div class="header__brand">
      <a href={logoHref} class="header__logo">
        <span class="header__mark" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="5.5" cy="16.5" r="3.1"></circle>
            <circle cx="18.5" cy="16.5" r="3.1"></circle>
            <circle cx="11" cy="16.5" r="1.15"></circle>
            <path d="M5.5 16.5h5.5"></path>
            <path d="M11 16.5 8.5 8.5"></path>
            <path d="M6.75 8.5h4"></path>
            <path d="M10.5 8.5 15.25 12.25"></path>
            <path d="M11 16.5 15.25 12.25 18.5 16.5"></path>
            <path d="M15.25 12.25h3.5V9.75"></path>
          </svg>
        </span>
        <span class="header__text">
          <strong>{strings.siteName}</strong>
          <span>{strings.tagline}</span>
        </span>
      </a>
      <span class="header__badge">{strings.dataBadge}</span>
      {stationCount > 0 && (
        <span class="header__count mono">{stationCount} {strings.stations}</span>
      )}
    </div>

    <div class="header__panel" id="site-menu">
      <div class="header__panel-inner">
        <nav class="header__links">
          {surface === 'site' && (
            <a class="header__app" href={appPath(locale)}>
              {strings.openApp}
            </a>
          )}
          <div class="header__legal-lang">
            <a class="header__license" href={licensePath(locale)} rel="license">
              {strings.licenseNav}
            </a>
            <LanguageSwitcher currentPath={currentPath} />
          </div>
        </nav>
        <nav class="header__social" aria-label="Social">
          <a
            class="header__icon header__icon--mail"
            href="mailto:daniruso@duck.com"
            aria-label={strings.emailLabel}
          >
            <svg class="mail" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect class="mail__body" x="3" y="7.5" width="18" height="12" rx="2"></rect>
              <path class="mail__lid" d="M3.2 8 L12 14.5 L20.8 8"></path>
            </svg>
          </a>
          <a
            class="header__icon"
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={strings.githubLabel}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
          <a
            class="header__icon"
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={strings.linkedinLabel}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            class="header__icon header__icon--about"
            href={PERSONAL_SITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={strings.aboutLabel}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M5 20c0-3.5 3.1-6 7-6s7 2.5 7 6"></path>
            </svg>
          </a>
        </nav>
      </div>
    </div>

    <div class="header__actions">
      <ThemeToggle locale={locale} />
      <button
        class="header__menu-toggle"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={strings.menuOpen}
        data-label-open={strings.menuOpen}
        data-label-close={strings.menuClose}
      >
        <span class="header__menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelector('[data-header]')?.classList.add('has-js-menu');
</script>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.getElementById('menu-toggle');
  const panel = document.getElementById('site-menu');
  if (header && btn && panel) {
    header.classList.add('has-js-menu');

    const mq = window.matchMedia('(max-width: 720px)');
    const labelOpen = btn.getAttribute('data-label-open') ?? 'Open menu';
    const labelClose = btn.getAttribute('data-label-close') ?? 'Close menu';

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? labelClose : labelOpen);
      if (mq.matches) panel.toggleAttribute('inert', !open);
    };

    const syncViewport = () => {
      if (mq.matches) {
        setOpen(header.classList.contains('is-open'));
      } else {
        header.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', labelOpen);
        panel.removeAttribute('inert');
      }
    };

    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!header.classList.contains('is-open'));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    // Don't close the menu on same-tab navigations (language, license, app).
    // Closing toggles `inert` / `pointer-events: none` in the same click turn and
    // cancels the browser's default navigation in Chrome/Safari.
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href') ?? '';
        const isExternalTab = link.getAttribute('target') === '_blank';
        const isMail = href.startsWith('mailto:');
        if (isExternalTab || isMail) setOpen(false);
      });
    });

    mq.addEventListener('change', syncViewport);
    syncViewport();
  }
</script>

<style>
  .header {
    position: relative;
    z-index: 40;
    flex-shrink: 0;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper-elevated);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--header-h);
    padding: 0 1rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .header__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
  }

  .header__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .header__text strong {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .header__text span:last-child {
    font-size: 0.75rem;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__badge {
    display: none;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header__count {
    display: none;
    font-size: 0.6875rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .header__panel {
    margin-left: auto;
  }

  .header__panel-inner {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .header__legal-lang {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .header__social {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .header__app {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  :global(html[data-theme='dark']) .header__app {
    color: #0f1210;
  }

  .header__app:hover,
  .header__app:focus-visible {
    filter: brightness(1.06);
  }

  .header__license {
    padding: 0.4rem 0.55rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    white-space: nowrap;
  }

  .header__license:hover,
  .header__license:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .header__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    opacity: 0.72;
    overflow: visible;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .header__icon:hover,
  .header__icon:focus-visible {
    opacity: 1;
  }

  .header__icon svg {
    display: block;
    overflow: visible;
  }

  .header__icon--mail:hover,
  .header__icon--mail:focus-visible {
    transform: translateY(-0.28rem);
  }

  .mail__lid {
    transform-box: view-box;
    transform-origin: 12px 8px;
    transition: transform 0.38s var(--ease);
  }

  .header__icon--mail:hover .mail__lid,
  .header__icon--mail:focus-visible .mail__lid {
    transform: scaleY(-1);
  }

  .header__menu-toggle {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .header__menu-bars {
    position: relative;
    display: block;
    width: 1.15rem;
    height: 0.85rem;
  }

  .header__menu-bars span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      top var(--dur) var(--ease);
  }

  .header__menu-bars span:nth-child(1) {
    top: 0;
  }

  .header__menu-bars span:nth-child(2) {
    top: calc(50% - 0.75px);
  }

  .header__menu-bars span:nth-child(3) {
    top: calc(100% - 1.5px);
  }

  .header.is-open .header__menu-bars span:nth-child(1) {
    top: calc(50% - 0.75px);
    transform: rotate(45deg);
  }

  .header.is-open .header__menu-bars span:nth-child(2) {
    opacity: 0;
  }

  .header.is-open .header__menu-bars span:nth-child(3) {
    top: calc(50% - 0.75px);
    transform: rotate(-45deg);
  }

  .mono {
    font-family: var(--font-mono);
  }

  @media (min-width: 640px) {
    .header__inner {
      padding: 0 1.25rem;
    }

    .header__badge {
      display: inline-flex;
    }

    .header__count {
      display: inline;
    }
  }

  @media (max-width: 720px) {
    .header__inner {
      flex-wrap: wrap;
      gap: 0;
      min-height: 0;
      padding-block: 0.55rem;
    }

    .header__brand {
      flex: 1;
      min-width: 0;
    }

    .header__text span:last-child {
      display: none;
    }

    .header__actions {
      margin-left: auto;
    }

    .header.has-js-menu .header__menu-toggle {
      display: grid;
    }

    .header.has-js-menu .header__panel {
      order: 3;
      flex: 1 0 100%;
      margin-left: 0;
    }

    .header.has-js-menu .header__panel-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      transition:
        max-height var(--dur) var(--ease),
        opacity var(--dur) var(--ease),
        padding var(--dur) var(--ease);
    }

    .header.has-js-menu.is-open .header__panel-inner {
      max-height: 20rem;
      opacity: 1;
      pointer-events: auto;
      padding-top: 0.85rem;
      padding-bottom: 0.35rem;
    }

    .header__links {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.55rem;
      width: 100%;
    }

    .header__legal-lang {
      justify-content: flex-end;
      width: 100%;
    }

    .header__social {
      justify-content: flex-end;
      gap: 0.25rem;
      width: 100%;
      padding-bottom: 0.35rem;
      border-bottom: 1px solid var(--hairline);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header.has-js-menu .header__panel-inner,
    .header__menu-bars span {
      transition: none;
    }
  }
</style>

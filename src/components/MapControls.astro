---
import type { Locale } from '../lib/i18n';
import { t, formatHour, EMT_URL } from '../lib/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const hours = Array.from({ length: 24 }, (_, i) => i);
const tickHours = [0, 6, 12, 18, 23];
const hoursLabels = hours.map((h) => formatHour(h, locale));
---

<div class="controls" data-controls data-hours-labels={JSON.stringify(hoursLabels)} data-day-pulse-value={strings.dayPulseValue} data-view-mode="hourly">
  <p class="controls__note">{strings.dataNote}</p>

  <div class="controls__row">
    <div class="control-group">
      <span class="control-group__label" id="view-mode-label">{strings.viewModeLabel}</span>
      <div class="chip-group chip-group--row" role="group" aria-labelledby="view-mode-label">
        <button type="button" class="chip is-active" data-view-mode="hourly" aria-pressed="true">{strings.viewHourly}</button>
        <button type="button" class="chip" data-view-mode="dayPulse" aria-pressed="false">{strings.viewDayPulse}</button>
      </div>
      <p class="controls__mode-hint" data-mode-hint hidden>{strings.dayPulseHint}</p>
    </div>
  </div>

  <div class="controls__row" data-time-block>
    <div class="control-group">
      <label class="control-group__label" for="hour-slider">{strings.timeLabel}</label>
      <div class="time-control">
        <output class="time-control__value mono" id="hour-display" for="hour-slider">
          {formatHour(8, locale)}
        </output>
        <div class="time-control__marks" aria-hidden="true">
          <span class="time-control__mark time-control__mark--sun">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <g class="sun-rays">
                <path class="sun-ray" style="--dx: 0; --dy: -1" d="M12 2v2"></path>
                <path class="sun-ray" style="--dx: 0; --dy: 1" d="M12 20v2"></path>
                <path class="sun-ray" style="--dx: -0.707; --dy: -0.707" d="M4.93 4.93l1.41 1.41"></path>
                <path class="sun-ray" style="--dx: 0.707; --dy: 0.707" d="M17.66 17.66l1.41 1.41"></path>
                <path class="sun-ray" style="--dx: -1; --dy: 0" d="M2 12h2"></path>
                <path class="sun-ray" style="--dx: 1; --dy: 0" d="M20 12h2"></path>
                <path class="sun-ray" style="--dx: -0.707; --dy: 0.707" d="M4.93 19.07l1.41-1.41"></path>
                <path class="sun-ray" style="--dx: 0.707; --dy: -0.707" d="M17.66 6.34l1.41-1.41"></path>
              </g>
              <circle class="sun-core" cx="12" cy="12" r="5"></circle>
            </svg>
          </span>
          <span class="time-control__mark time-control__mark--moon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linejoin="miter" stroke-miterlimit="8">
              <g class="moon-body">
                <path d="M13.75 4.43A8.2 8.2 0 1 0 13.75 19.57 7.7 7.7 0 0 1 13.75 4.43Z" transform="rotate(-38 12 12)"></path>
              </g>
            </svg>
          </span>
        </div>
        <div class="time-control__rail">
          <input
            type="range"
            id="hour-slider"
            class="time-control__slider"
            min="0"
            max="23"
            value="8"
            step="1"
            aria-valuemin="0"
            aria-valuemax="23"
            aria-valuenow="8"
          />
        </div>
        <div class="time-control__ticks" aria-hidden="true">
          {tickHours.map((h) => (
            <span>{formatHour(h, locale)}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="controls__row controls__row--chips">
    <div class="control-group">
      <span class="control-group__label" id="day-type-label">{strings.dayTypeLabel}</span>
      <div class="chip-group" role="group" aria-labelledby="day-type-label">
        <button type="button" class="chip is-active" data-day-type="weekday" aria-pressed="true">{strings.weekday}</button>
        <button type="button" class="chip is-disabled" data-day-type="weekend" disabled title={strings.allYearSoon} aria-disabled="true">{strings.weekend}</button>
      </div>
    </div>

    <div class="control-group">
      <span class="control-group__label" id="season-label">{strings.seasonLabel}</span>
      <div class="chip-group" role="group" aria-labelledby="season-label">
        <button type="button" class="chip is-active" data-season="summer" aria-pressed="true">{strings.summer}</button>
        <button type="button" class="chip is-disabled" disabled title={strings.allYearSoon}>{strings.allYear}</button>
      </div>
    </div>
  </div>

  <div class="legend" aria-hidden="true">
    <span>{strings.legendLow}</span>
    <span class="legend__bar"></span>
    <span>{strings.legendHigh}</span>
  </div>

  <p class="controls__copy">
    <span>{strings.copyrightLine}</span>
    <a href={locale === 'en' ? '/en/license/' : '/licencia/'} rel="license">{strings.licenseShort}</a>
    <a href={EMT_URL} target="_blank" rel="noopener noreferrer">{strings.poweredByEmt}</a>
  </p>
</div>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem 1.1rem 1.15rem;
    border-radius: var(--panel-radius);
    background: var(--map-overlay);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .controls__note {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .controls__mode-hint {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .controls__mode-hint[hidden] {
    display: none;
  }

  .controls[data-view-mode='dayPulse'] [data-time-block] {
    opacity: 0.4;
    pointer-events: none;
  }

  .controls__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .controls__row--chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1rem;
    align-items: start;
  }

  .controls__row--chips .control-group {
    gap: 0.4rem;
  }

  .controls__row--chips .control-group__label {
    text-align: center;
  }

  @media (max-width: 380px) {
    .controls__row--chips {
      grid-template-columns: 1fr;
    }
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    min-width: 0;
  }

  .control-group__label {
    display: block;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .time-control {
    --thumb-size: 1.1rem;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 0.2rem;
    align-items: center;
  }

  .time-control__value {
    grid-column: 1;
    grid-row: 1;
    z-index: 1;
    justify-self: start;
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--accent);
    white-space: nowrap;
  }

  .time-control__marks {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    height: 1.6rem;
    overflow: visible;
    pointer-events: none;
  }

  .time-control__rail {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    align-items: center;
    min-height: var(--thumb-size);
  }

  .time-control__mark {
    --near: 0;
    position: absolute;
    top: 50%;
    width: 1.4375rem;
    height: 1.4375rem;
    color: var(--ink-muted);
    overflow: visible;
    transform: translate(-50%, -50%);
  }

  .sun-core,
  .moon-body path {
    fill: var(--ink);
    fill-opacity: var(--near);
    transition: fill-opacity 0.4s var(--ease);
  }

  .sun-ray {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s var(--ease);
    transform: translate(
      calc(var(--dx) * 3.6px * var(--near)),
      calc(var(--dy) * 3.6px * var(--near))
    );
  }

  .moon-body {
    transform-box: view-box;
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--ease);
    transform: rotate(calc(28deg * var(--near)));
  }

  .time-control__mark svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .time-control__mark--sun {
    left: 50%;
  }

  .time-control__mark--moon {
    left: 100%;
    transform: translate(-100%, -50%);
  }

  .time-control__slider {
    width: 100%;
    height: var(--thumb-size);
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }

  .time-control__slider:disabled {
    cursor: not-allowed;
  }

  .time-control__slider::-webkit-slider-runnable-track {
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--hour-night),
      var(--hour-day) 50%,
      var(--hour-night)
    );
  }

  .time-control__slider::-webkit-slider-thumb {
    appearance: none;
    width: var(--thumb-size);
    height: var(--thumb-size);
    margin-top: calc((0.35rem - var(--thumb-size)) / 2);
    border-radius: 50%;
    border: 2px solid var(--paper);
    background: var(--ink);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .time-control__slider::-moz-range-track {
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--hour-night),
      var(--hour-day) 50%,
      var(--hour-night)
    );
  }

  .time-control__slider::-moz-range-thumb {
    width: var(--thumb-size);
    height: var(--thumb-size);
    border-radius: 50%;
    border: 2px solid var(--paper);
    background: var(--ink);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .time-control__ticks {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ink-muted);
  }

  .chip-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    min-width: 0;
  }

  .chip-group--row {
    flex-direction: row;
  }

  .chip-group--row .chip {
    flex: 1;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--chip-border);
    border-radius: 999px;
    background: var(--chip-bg);
    appearance: none;
    -webkit-appearance: none;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .chip:hover:not(:disabled):not(.is-active) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip.is-active:hover:not(:disabled) {
    filter: brightness(0.92);
  }

  .chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  html[data-theme='dark'] .chip.is-active {
    color: #0f1210;
  }

  .chip.is-disabled,
  .chip:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  .legend__bar {
    flex: 1;
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--legend-low), var(--legend-mid), var(--legend-high));
  }

  .controls__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin: 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.75rem;
    color: var(--ink);
  }

  .controls__copy a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 520px) {
    .controls {
      gap: 0.55rem;
      padding: 0.75rem 0.85rem 0.85rem;
    }

    .controls__note,
    .controls__copy {
      display: none;
    }

    .controls__row--chips {
      gap: 0.35rem 0.65rem;
    }

    .chip {
      padding: 0.35rem 0.55rem;
      font-size: 0.75rem;
    }

    .time-control__value {
      font-size: 1.15rem;
    }
  }

  .mono {
    font-family: var(--font-mono);
  }
</style>

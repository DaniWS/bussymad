---
import type { Locale } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<div
  class="install-banner"
  data-install-banner
  hidden
  role="region"
  aria-label={strings.installAsk}
  data-ask={strings.installAsk}
  data-ios={strings.installIosHint}
  data-firefox={strings.installFirefoxHint}
  data-chrome-wait={strings.installChromeWaitHint}
  data-insecure={strings.installInsecureHint}
  data-remove-old={strings.installRemoveOldHint}
>
  <p class="install-banner__copy" data-install-copy>{strings.installAsk}</p>
  <div class="install-banner__actions">
    <button type="button" class="install-banner__yes" data-install-accept hidden>
      {strings.installAction}
    </button>
    <button type="button" class="install-banner__no" data-install-dismiss>
      {strings.installLater}
    </button>
  </div>
</div>

<style>
  .install-banner {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    flex-shrink: 0;
    z-index: 50;
    padding: 0.7rem 1rem;
    padding-top: max(0.7rem, env(safe-area-inset-top));
    background: var(--paper-elevated);
    border-bottom: 1px solid var(--hairline);
    box-shadow: var(--shadow);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .install-banner[hidden] {
    display: none !important;
  }

  .install-banner.is-visible:not([hidden]) {
    display: flex;
  }

  .install-banner__copy {
    margin: 0;
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .install-banner__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .install-banner__yes,
  .install-banner__no {
    margin: 0;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
  }

  .install-banner__yes[hidden] {
    display: none !important;
  }

  .install-banner__yes {
    background: var(--accent);
    color: var(--paper);
  }

  :global(html[data-theme='dark']) .install-banner__yes {
    color: #0f1210;
  }

  .install-banner__no {
    background: transparent;
    border-color: var(--hairline);
    color: var(--ink-muted);
  }

  @media (max-width: 420px) {
    .install-banner {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'busymad.install-banner.v4';

  type BeforeInstallPromptEvent = Event & {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  };

  type Mode = 'bip' | 'ios' | 'firefox' | 'chrome-wait' | 'insecure';

  const banner = document.querySelector<HTMLElement>('[data-install-banner]');
  const copyEl = banner?.querySelector<HTMLElement>('[data-install-copy]');
  const acceptBtn = banner?.querySelector<HTMLButtonElement>('[data-install-accept]');
  const dismissBtn = banner?.querySelector<HTMLButtonElement>('[data-install-dismiss]');

  let deferredPrompt: BeforeInstallPromptEvent | null = null;
  let mode: Mode | null = null;

  function isStandalone() {
    return (
      window.matchMedia('(display-mode: standalone)').matches ||
      window.matchMedia('(display-mode: fullscreen)').matches ||
      window.matchMedia('(display-mode: minimal-ui)').matches ||
      ('standalone' in navigator && Boolean((navigator as Navigator & { standalone?: boolean }).standalone))
    );
  }

  function isMobile() {
    const ua = navigator.userAgent;
    if (/Android|iPhone|iPad|iPod|Mobile/i.test(ua)) return true;
    return window.matchMedia('(max-width: 900px) and (pointer: coarse)').matches;
  }

  function isPrivateHost() {
    const host = location.hostname;
    return (
      host === 'localhost' ||
      host === '127.0.0.1' ||
      /^192\.168\./.test(host) ||
      /^10\./.test(host) ||
      /^172\.(1[6-9]|2\d|3[0-1])\./.test(host)
    );
  }

  function isInsecureForWebApk() {
    return !window.isSecureContext || (location.protocol === 'http:' && isPrivateHost() && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1');
  }

  function isIos() {
    return /iPhone|iPad|iPod/i.test(navigator.userAgent);
  }

  function isIosSafari() {
    const ua = navigator.userAgent;
    return isIos() && /WebKit/i.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS/i.test(ua);
  }

  function isFirefox() {
    return /Firefox|FxiOS/i.test(navigator.userAgent);
  }

  function dismissed() {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'dismissed';
    } catch {
      return false;
    }
  }

  function hide() {
    banner?.setAttribute('hidden', '');
    banner?.classList.remove('is-visible');
  }

  function hintFor(next: Mode): string {
    if (!banner) return '';
    if (next === 'ios') return banner.dataset.ios ?? banner.dataset.ask ?? '';
    if (next === 'firefox') return banner.dataset.firefox ?? banner.dataset.ask ?? '';
    if (next === 'insecure') return banner.dataset.insecure ?? banner.dataset.ask ?? '';
    if (next === 'chrome-wait') return banner.dataset.chromeWait ?? banner.dataset.ask ?? '';
    return banner.dataset.ask ?? '';
  }

  function show(nextMode: Mode) {
    if (!banner || isStandalone()) return;
    if (dismissed() && nextMode !== 'bip') return;

    mode = nextMode;
    if (acceptBtn) {
      acceptBtn.hidden = nextMode !== 'bip';
    }
    if (copyEl) {
      copyEl.textContent = hintFor(nextMode);
    }
    banner.removeAttribute('hidden');
    banner.classList.add('is-visible');
  }

  function pickInitialMode(): Mode {
    if (isInsecureForWebApk() && !isIosSafari()) return 'insecure';
    if (isIosSafari() || (isIos() && !isFirefox())) return 'ios';
    if (isFirefox()) return 'firefox';
    return 'chrome-wait';
  }

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    deferredPrompt = event as BeforeInstallPromptEvent;
    show('bip');
  });

  window.addEventListener('appinstalled', () => {
    try {
      localStorage.setItem(STORAGE_KEY, 'dismissed');
    } catch {
      /* ignore */
    }
    hide();
  });

  if (banner && isMobile() && !isStandalone() && !dismissed()) {
    show(pickInitialMode());
  }

  dismissBtn?.addEventListener('click', () => {
    try {
      localStorage.setItem(STORAGE_KEY, 'dismissed');
    } catch {
      /* ignore */
    }
    hide();
  });

  acceptBtn?.addEventListener('click', async () => {
    if (mode !== 'bip' || !deferredPrompt) return;
    await deferredPrompt.prompt();
    const choice = await deferredPrompt.userChoice;
    deferredPrompt = null;
    if (choice.outcome === 'accepted') {
      try {
        localStorage.setItem(STORAGE_KEY, 'dismissed');
      } catch {
        /* ignore */
      }
      hide();
    }
  });
</script>

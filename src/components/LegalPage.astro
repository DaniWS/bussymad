---
import Header from './Header.astro';
import type { Locale } from '../lib/i18n';
import { t, LICENSE_URL } from '../lib/translations';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const strings = t(locale);
const homeHref = locale === 'en' ? '/en/' : '/';
---

<div class="legal">
  <Header locale={locale} currentPath={currentPath} />
  <main class="legal__main" id="main-content">
    <a class="legal__back" href={homeHref}>{strings.licenseBack}</a>
    <h1>{strings.licensePageTitle}</h1>
    <p class="legal__lede">{strings.licenseIntro}</p>

    <section>
      <h2>{strings.licenseAllows}</h2>
      <ul>
        <li>{strings.licenseAllowView}</li>
        <li>{strings.licenseAllowShare}</li>
      </ul>
    </section>

    <section>
      <h2>{strings.licenseForbids}</h2>
      <ul>
        <li>{strings.licenseForbidCommercial}</li>
        <li>{strings.licenseForbidDerivatives}</li>
        <li>{strings.licenseForbidPlagiarism}</li>
      </ul>
    </section>

    <p class="legal__data">{strings.licenseData}</p>

    <p class="legal__full">
      <a href={LICENSE_URL} rel="license" target="_blank">{strings.licenseFull} ({strings.licenseShort})</a>
    </p>

    <p class="legal__copy">{strings.copyrightLine}</p>
  </main>
</div>

<style>
  .legal {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .legal__main {
    width: min(42rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .legal__back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  h2 {
    margin: 1.75rem 0 0.6rem;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .legal__lede,
  .legal__data,
  li {
    line-height: 1.55;
    color: var(--ink);
  }

  .legal__lede {
    margin: 0 0 0.5rem;
  }

  ul {
    margin: 0;
    padding-left: 1.15rem;
  }

  li + li {
    margin-top: 0.35rem;
  }

  .legal__data {
    margin-top: 1.75rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  .legal__full a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .legal__copy {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
</style>

---
import Header from './Header.astro';
import type { Locale } from '../lib/i18n';
import { homePath } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const strings = t(locale);
---

<div class="faq">
  <Header locale={locale} currentPath={currentPath} surface="doc" />
  <main class="faq__main" id="main-content">
    <a class="faq__back" href={homePath(locale)}>{strings.faqBack}</a>
    <h1>{strings.seoFaqTitle}</h1>
    <p class="faq__lede">{strings.faqIntro}</p>

    {strings.seoFaq.map((item) => (
      <section class="faq__item">
        <h2>{item.q}</h2>
        <p>{item.a}</p>
      </section>
    ))}
  </main>
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .faq__main {
    width: min(42rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .faq__back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .faq__lede {
    margin: 0 0 0.5rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .faq__item {
    margin-top: 1.75rem;
  }

  .faq__item h2 {
    margin: 0 0 0.45rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .faq__item p {
    margin: 0;
    line-height: 1.55;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
</style>

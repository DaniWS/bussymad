---
import Header from './Header.astro';
import type { Locale } from '../lib/i18n';
import { appPath } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const strings = t(locale);
const href = appPath(locale);
---

<div class="site">
  <Header locale={locale} currentPath={currentPath} surface="site" />

  <main class="page" id="main-content">
    <div class="hero">
      <span class="hero__mark" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="17" r="3.2"></circle>
          <circle cx="18" cy="17" r="3.2"></circle>
          <path d="M9 17h6M6 14l3-7h6l3 7"></path>
          <path d="M12 7V4"></path>
        </svg>
      </span>
      <p class="hero__kicker">{strings.dataBadge}</p>
      <h1>{strings.siteName}</h1>
      <p class="hero__lede">{strings.landingLede}</p>
      <a class="hero__cta" href={href}>{strings.openApp}</a>
      <p class="hero__hint">{strings.landingHint}</p>
    </div>

    <section class="demo" aria-label={strings.demoLabel}>
      <figure class="demo__item">
        <img
          class="demo__media"
          src="/demo/hourly.gif"
          width="560"
          height="490"
          alt={strings.demoHourlyAlt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="demo__caption">
          <strong>{strings.viewHourly}</strong>
          <span>{strings.demoHourlyCaption}</span>
        </figcaption>
      </figure>

      <figure class="demo__item">
        <img
          class="demo__media"
          src="/demo/rating.png"
          width="345"
          height="269"
          alt={strings.demoRatingAlt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="demo__caption">
          <strong>{strings.viewDayPulse}</strong>
          <span>{strings.demoRatingCaption}</span>
        </figcaption>
      </figure>
    </section>
  </main>
</div>

<style>
  .site {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .page {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: min(54rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.5rem 0 3.5rem;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(36rem, 100%);
  }

  .hero__mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 1.25rem;
    border-radius: 0.85rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .hero__kicker {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .hero__lede {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--paper);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  :global(html[data-theme='dark']) .hero__cta {
    color: #0f1210;
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    filter: brightness(1.06);
  }

  .hero__hint {
    margin: 0.85rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .demo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .demo__item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0;
    min-width: 0;
  }

  .demo__media {
    display: block;
    width: 100%;
    aspect-ratio: 560 / 490;
    height: auto;
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    border: 1px solid var(--hairline);
    background: #0f1418;
  }

  .demo__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .demo__caption strong {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .demo {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Landing from '../components/Landing.astro';
import { datasetJsonLd, webApplicationJsonLd, webSiteJsonLd } from '../lib/seo';

const pageUrl = 'https://busymad.pages.dev/';
const jsonLd = [webSiteJsonLd('es', pageUrl), webApplicationJsonLd('es', pageUrl), datasetJsonLd('es')];
---

<BaseLayout locale="es" layout="site" jsonLd={jsonLd}>
  <Landing locale="es" currentPath="/" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapApp from '../../components/MapApp.astro';
import { t } from '../../lib/translations';
import { webApplicationJsonLd } from '../../lib/seo';

const strings = t('en');
const pageUrl = 'https://busymad.pages.dev/en/app/';
---

<BaseLayout
  locale="en"
  layout="map"
  title={strings.appPageTitle}
  description={strings.appMetaDescription}
  alternateEs="/app/"
  alternateEn="/en/app/"
  jsonLd={webApplicationJsonLd('en', pageUrl)}
>
  <MapApp locale="en" currentPath="/en/app/" />
</BaseLayout>

---
import { pwaInfo } from 'virtual:pwa-info';
import '../styles/global.css';
import InstallBanner from '../components/InstallBanner.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  layout?: 'map' | 'doc' | 'site';
  alternateEs?: string;
  alternateEn?: string;
  ogImage?: string;
}

const locale = Astro.props.locale ?? 'es';
const layout = Astro.props.layout ?? 'map';
const strings = t(locale);
const pageTitle = Astro.props.title ?? strings.pageTitle;
const metaDescription = Astro.props.description ?? strings.metaDescription;
const siteOrigin = Astro.site?.origin ?? 'https://busymad.pages.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const esPath = Astro.props.alternateEs ?? '/';
const enPath = Astro.props.alternateEn ?? '/en/';
const esUrl = new URL(esPath, siteOrigin).href;
const enUrl = new URL(enPath, siteOrigin).href;
const ogImagePath = Astro.props.ogImage ?? '/demo/rating.png';
const ogImageUrl = new URL(ogImagePath, siteOrigin).href;
const skipHref = layout === 'map' ? '#map-root' : '#main-content';
const skipLabel = layout === 'map' ? strings.skipLink : strings.skipContent;
const umamiWebsiteId =
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? '540c677d-8a72-43b9-9936-4412d6826fec';

if (layout === 'site') {
  await import('@fontsource/dm-sans/latin-400.css');
  await import('@fontsource/dm-sans/latin-600.css');
  await import('@fontsource/dm-sans/latin-700.css');
} else {
  await import('@fontsource/dm-sans/latin-400.css');
  await import('@fontsource/dm-sans/latin-500.css');
  await import('@fontsource/dm-sans/latin-600.css');
  await import('@fontsource/dm-sans/latin-700.css');
  await import('@fontsource/jetbrains-mono/latin-400.css');
}
---

<!doctype html>
<html lang={locale} data-layout={layout}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Daniel Vilela García" />
    <meta name="copyright" content="© 2026 Daniel Vilela García" />
    <meta name="theme-color" content="#1a7f5a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={strings.siteName} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc-nd/4.0/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {layout === 'site' && (
      <link rel="preload" href="/logo.png?v=2" as="image" type="image/png" fetchpriority="high" />
    )}
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{pageTitle}</title>
    {umamiWebsiteId && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={umamiWebsiteId}
        data-domains="busymad.dev,busymad.pages.dev"
      />
    )}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <script is:inline>
      (function () {
        // Stale PWA shells can serve Spanish HTML at /en/* (or the reverse). Recover.
        var path = location.pathname;
        var pathEn = path === '/en' || path.indexOf('/en/') === 0;
        var htmlEn = document.documentElement.lang === 'en';
        var flag = 'busymad-locale-repair';
        if (pathEn === htmlEn) {
          try {
            sessionStorage.removeItem(flag);
          } catch (_) {}
          return;
        }
        try {
          var attempts = Number(sessionStorage.getItem(flag) || '0');
          if (attempts >= 2) return;
          sessionStorage.setItem(flag, String(attempts + 1));
        } catch (_) {}
        var done = function () {
          location.reload();
        };
        if (!('serviceWorker' in navigator)) {
          done();
          return;
        }
        navigator.serviceWorker.getRegistrations().then(function (regs) {
          return Promise.all(
            regs.map(function (r) {
              return r.unregister();
            }),
          );
        }).then(function () {
          if (!('caches' in window)) return;
          return caches.keys().then(function (keys) {
            return Promise.all(
              keys.map(function (k) {
                return caches.delete(k);
              }),
            );
          });
        }).then(done, done);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href={skipHref}>{skipLabel}</a>
    <InstallBanner locale={locale} />
    <slot />
    <script src="../pwa.ts"></script>
  </body>
</html>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GBFS collector for macOS (launchd), every 30 minutes.

  Install:
    1. Edit WorkingDirectory / ProgramArguments paths if your clone is not at ~/busymad
    2. cp scripts/com.busymad.gbfs.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.busymad.gbfs.plist
    4. launchctl start com.busymad.gbfs   # optional immediate run

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.busymad.gbfs.plist

  Caveat: LaunchAgents do NOT run while the Mac is asleep. Missed intervals catch up
  on wake only if you use StartCalendarInterval (one fire per slot after wake,
  not backfill). For reliable 24/7 collection, prefer GitHub Actions.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.busymad.gbfs</string>

  <key>WorkingDirectory</key>
  <string>/Users/danielg/busymad</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/danielg/busymad/scripts/collect_gbfs.py</string>
  </array>

  <!-- Fire at :05 and :35 every hour -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>35</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/danielg/busymad/data/collected/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/danielg/busymad/data/collected/launchd.err.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>

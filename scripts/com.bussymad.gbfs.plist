<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly GBFS collector for macOS (launchd).

  Install:
    1. Edit WorkingDirectory / ProgramArguments paths if your clone is not at ~/bussymad
    2. cp scripts/com.bussymad.gbfs.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.bussymad.gbfs.plist
    4. launchctl start com.bussymad.gbfs   # optional immediate run

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.bussymad.gbfs.plist

  Caveat: LaunchAgents do NOT run while the Mac is asleep. Missed hours catch up
  on wake only if you use StartCalendarInterval (one fire per hour after wake,
  not backfill). For reliable 24/7 collection, prefer GitHub Actions.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bussymad.gbfs</string>

  <key>WorkingDirectory</key>
  <string>/Users/danielg/bussymad</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/danielg/bussymad/scripts/collect_gbfs.py</string>
  </array>

  <!-- Fire at minute 5 of every hour -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>5</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/danielg/bussymad/data/collected/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/danielg/bussymad/data/collected/launchd.err.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
